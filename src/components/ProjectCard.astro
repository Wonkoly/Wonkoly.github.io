---
import { loc, useT, type Lang } from "../i18n";
import type { Project } from "../data/projects";
import Icon from "./Icon.astro";

interface Props {
  project: Project;
  lang: Lang;
}

const { project: p, lang } = Astro.props;
const t = useT(lang);
const features = loc(p.features, lang) ?? [];
const fdroid = p.links?.find((l) => l.type === "fdroid");
---

<article
  id={p.id}
  class="flex min-w-0 scroll-mt-20 flex-col gap-3.5 rounded-[18px] border border-line bg-surface p-5 shadow-[0_1px_2px_rgb(60_40_20/.06),0_8px_24px_rgb(60_40_20/.06)]"
>
  <div class="flex items-center gap-3.5">
    {p.icon && <img src={p.icon} alt="" width="56" height="56" loading="lazy" class="size-14 flex-none rounded-[14px]" />}
    <div>
      <h3 class="font-serif text-2xl leading-tight font-semibold">{p.name}</h3>
      <p class="mt-0.5 text-sm text-muted">
        {loc(p.platform, lang)}
        {
          p.status && (
            <span class="ml-1.5 inline-block rounded-full border border-current px-2 text-xs font-semibold text-gold">
              {loc(p.status, lang)}
            </span>
          )
        }
      </p>
    </div>
  </div>

  <p>{loc(p.description, lang)}</p>

  {
    features.length > 0 && (
      <ul class="grid grid-cols-[repeat(auto-fill,minmax(190px,1fr))] gap-x-3 gap-y-1 text-[14.5px] text-muted">
        {features.map((f) => (
          <li class="before:text-accent before:content-['—_']">{f}</li>
        ))}
      </ul>
    )
  }

  {
    p.tags && p.tags.length > 0 && (
      <ul class="flex flex-wrap gap-1.5">
        {p.tags.map((tag) => (
          <li class="rounded-full bg-chip px-2.5 py-0.5 text-[13px] font-medium">{tag}</li>
        ))}
      </ul>
    )
  }

  {
    (p.links?.length || p.private) && (
      <div class="mt-auto flex flex-col gap-2.5 pt-1 min-[420px]:flex-row min-[420px]:flex-wrap">
        {p.links?.map((link) => {
          switch (link.type) {
            case "fdroid":
              return (
                <a class="btn btn-primary" href={link.url}>
                  <Icon name="fdroid" />
                  {loc(link.label, lang) ?? t["btn.fdroid"]}
                  <small class="font-medium opacity-75">· {t["btn.fdroidHint"]}</small>
                </a>
              );
            case "apk":
              return (
                <a
                  class="btn"
                  href={link.fallback}
                  data-apk-index={link.index}
                  data-apk-package={link.package}
                  data-apk-abi={link.abi}
                  data-apk-hint={t["btn.apkHint"]}
                >
                  <Icon name="download" />
                  {loc(link.label, lang) ?? t["btn.apk"]}
                  <small class="font-medium opacity-75">· {t["btn.apkHint"]}</small>
                </a>
              );
            default: {
              const icon = link.type === "release" ? "download" : link.type === "repo" ? "code" : "link";
              const label = loc(link.label, lang) ?? t[`btn.${link.type}`];
              const hint = loc(link.hint, lang);
              return (
                <a class:list={["btn", link.type === "release" && "btn-primary"]} href={link.url}>
                  <Icon name={icon} />
                  {label}
                  {hint && <small class="font-medium opacity-75">· {hint}</small>}
                </a>
              );
            }
          }
        })}
        {p.private && <p class="text-sm text-muted italic">{t.private}</p>}
      </div>
    )
  }

  {
    fdroid && (
      <details class="rounded-xl border border-dashed border-line px-3.5 text-[14.5px]">
        <summary class="cursor-pointer py-3 font-semibold text-muted">{t["fdroid.how"]}</summary>
        <ol class="mb-3 list-decimal space-y-1 pl-5">
          {t["fdroid.steps"].map((s) => (
            <li>{s}</li>
          ))}
        </ol>
        <div class="mb-3.5 flex gap-2">
          <code class="min-w-0 flex-1 truncate rounded-lg bg-chip px-2.5 py-2 text-[12.5px]">{fdroid.url}</code>
          <button
            type="button"
            class="btn min-h-9 px-3 py-1.5 text-[13px]"
            data-copy={fdroid.url}
            data-copied={t.copied}
          >
            {t.copy}
          </button>
        </div>
      </details>
    )
  }
</article>
